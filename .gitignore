# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Datasets, generated artifacts & model caches
/data/
/datasets/
/artifacts/
/models/
/downloads/
/uploads/
/transcripts/
/features/
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local tooling and editor state
.codegraph/
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Credentials and private configuration (never commit real secrets)
.env
.env.*
.envrc
.netrc
.pypirc
credentials.json
service-account*.json
secrets.*
*.pem
*.key
*.p12
*.pfx
*.keystore

# Audio/video, model weights, data exports and database backups
*.mp3
*.wav
*.m4a
*.flac
*.ogg
*.aac
*.sph
*.opus
*.wma
*.mp4
*.mkv
*.webm
*.avi
*.ckpt
*.pt
*.pth
