*.7z
*.rar

# Git patterns are case-sensitive; also exclude uppercase media extensions
*.[mM][pP]3
*.[wW][aA][vV]
*.[mM]4[aA]
*.[fF][lL][aA][cC]
*.[oO][gG][gG]
*.[aA][aA][cC]
*.[sS][pP][hH]
*.[oO][pP][uU][sS]
*.[wW][mM][aA]
*.[mM][pP]4
*.[mM][kK][vV]
*.[wW][eE][bB][mM]
*.[aA][vV][iI]
